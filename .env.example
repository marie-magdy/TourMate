
- 
+ # Local environment variables for docker-compose (replace placeholders)
+ # WARNING: This file may contain secrets. Do not publish to public repos.
+ 
+ # Backend
+ BACKEND_API_KEY=changeme
+ NODE_ENV=development
+ 
+ # Supabase (keep using Supabase; replace with your project's values)
+ SUPABASE_URL=https://your-project-ref.supabase.co
+ SUPABASE_KEY=your_supabase_anon_or_service_role_key
+ SUPABASE_DB_URL=postgresql://user:password@db-host:5432/dbname
+ 
+ # CV service
+ CV_API_KEY=changeme
+ 
+ # Optional overrides
+ # RECOMMENDER_URL=http://recommendation_service:5002
+ # CV_URL=http://cv_service:5001
+ 